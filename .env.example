# ==========================================================
# PrimeHavenCapital Environment Configuration Template
# Copy to .env or add to Vercel Project Settings
# ==========================================================

# Node.js Server Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (Neon PostgreSQL for Vercel & Production)
DB_ENGINE=postgres
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend Email API Configuration (Primary: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="PrimeHavenCapital <no_reply@primehavencapital.ltd>"
EMAIL_FROM_NAME="PrimeHavenCapital"

# Fallback SMTP Email System Configuration (Optional)
SMTP_HOST=mail.primehavencapital.ltd
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@primehavencapital.ltd
SMTP_PASS=your_smtp_password_here
SMTP_FROM=support@primehavencapital.ltd
SMTP_FROM_NAME="PrimeHavenCapital"
